# Copie este arquivo para .env e preencha os valores.
#   cp .env.example .env   (Linux/macOS)
#   Copy-Item .env.example .env   (Windows/PowerShell)

# Flask
SECRET_KEY=gerar-uma-chave-secreta-longa-e-aleatoria
SQLALCHEMY_DATABASE_URI=sqlite:///portfolio.db

# Stripe (use chaves de TESTE em desenvolvimento)
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_XXXXXXXX
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXX

# URL base usada nos redirects do Checkout (sucesso/cancelamento)
# Em produção use o domínio, ex.: https://seudominio.com
BASE_URL=http://127.0.0.1:5000